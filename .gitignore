# Bundler and local tooling
/.bundle
/.ruby-lsp

# Environment variables and application secrets
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key
/.kamal/secrets

# Logs and temporary files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# Local uploads and SQLite databases
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Generated assets and JavaScript dependencies
/node_modules
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Operating system files
.DS_Store
