<header class="border-b border-white/70 bg-white/90 shadow-sm backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-3" do %>
      <span class="grid size-11 place-items-center overflow-hidden rounded-2xl bg-white p-1 shadow-lg shadow-emerald-600/15 ring-1 ring-emerald-100">
        <%= image_tag "inluah-icon.png", alt: "Inluah", class: "size-full object-contain" %>
      </span>
      <span class="leading-tight">
        <span class="block text-xl font-black tracking-tight">Inluah</span>
        <span class="hidden text-xs font-semibold uppercase text-emerald-700 sm:block">Aizawl rentals</span>
      </span>
    <% end %>

    <div class="hidden flex-1 md:block">
      <%= form_with url: properties_path, method: :get, class: "mx-auto flex max-w-xl items-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2 shadow-inner" do |form| %>
        <%= form.search_field :q, value: params[:q], placeholder: "Search Chanmari, apartment, room...", class: "w-full border-0 bg-transparent text-sm outline-none placeholder:text-slate-400 focus:ring-0" %>
        <%= button_tag class: "rounded-full bg-emerald-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-emerald-700" do %>
          Search
        <% end %>
      <% end %>
    </div>

    <nav class="ml-auto hidden items-center gap-1 text-sm font-bold md:flex">
      <%= link_to "Listings", properties_path, class: "rounded-full px-4 py-2 #{nav_link_classes(properties_path)}" %>
      <%= link_to "Post property", new_property_path, class: "rounded-full bg-slate-950 px-4 py-2 text-white hover:bg-emerald-700" %>
      <% if user_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "rounded-full px-4 py-2 #{nav_link_classes(dashboard_path)}" if owner_user? %>
        <%= link_to "Admin", admin_root_path, class: "rounded-full px-4 py-2 text-emerald-700" if admin_user? %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "rounded-full px-4 py-2 text-slate-500 hover:text-rose-600" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "rounded-full px-4 py-2 text-slate-600 hover:text-emerald-700" %>
      <% end %>
    </nav>

    <%= link_to properties_path, class: "ml-auto grid size-11 place-items-center rounded-2xl bg-slate-100 text-slate-700 md:hidden", aria: { label: "Search" } do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <% end %>
  </div>
</header>
