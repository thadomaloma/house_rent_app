<article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-emerald-950/10">
  <div class="relative aspect-[4/3] overflow-hidden bg-emerald-50">
    <%= link_to property_path(property), class: "block h-full" do %>
      <% if property.photos.attached? %>
        <%= image_tag property.photos.first, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: property.title %>
      <% else %>
        <%= image_tag "/fallback-property.svg", class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: "Inluah property placeholder" %>
      <% end %>
    <% end %>
    <div class="absolute left-4 top-4 flex flex-wrap gap-2">
      <% if property.featured? %>
        <span class="rounded-full bg-emerald-600 px-3 py-1 text-xs font-black text-white shadow-lg">Featured</span>
      <% end %>
      <span class="rounded-full px-3 py-1 text-xs font-black ring-1 <%= status_badge_classes(property) %>"><%= property.status.humanize %></span>
    </div>
    <div class="absolute right-4 top-4">
      <%= render "properties/favorite_button", property: property %>
    </div>
  </div>

  <div class="space-y-4 p-5">
    <div>
      <div class="mb-2 flex items-center justify-between gap-3">
        <p class="text-xs font-black uppercase text-emerald-700"><%= property_area_label(property) %> · <%= property_type_label(property) %></p>
        <p class="text-lg font-black text-slate-950"><%= rupees(property.rent) %><span class="text-xs font-bold text-slate-500">/mo</span></p>
      </div>
      <h3 class="line-clamp-2 text-lg font-black tracking-tight text-slate-950">
        <%= link_to property.title, property_path(property), class: "hover:text-emerald-700" %>
      </h3>
      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500"><%= property.description %></p>
    </div>

    <div class="grid grid-cols-3 gap-2 text-center text-xs font-bold text-slate-600">
      <div class="rounded-2xl bg-slate-50 px-2 py-3"><span class="block text-sm font-black text-slate-950"><%= property.bedrooms %></span>Beds</div>
      <div class="rounded-2xl bg-slate-50 px-2 py-3"><span class="block text-sm font-black text-slate-950"><%= property.bathrooms %></span>Baths</div>
      <div class="rounded-2xl bg-slate-50 px-2 py-3"><span class="block text-sm font-black text-slate-950"><%= property.floor.presence || "-" %></span>Floor</div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "Call", "tel:#{property.phone}", class: "flex-1 rounded-2xl bg-slate-950 px-4 py-3 text-center text-sm font-black text-white hover:bg-emerald-700" %>
      <% if property.whatsapp_number.present? %>
        <%= link_to "WhatsApp", "https://wa.me/#{property.whatsapp_number.gsub(/\D/, "")}", target: "_blank", rel: "noopener", class: "flex-1 rounded-2xl bg-emerald-600 px-4 py-3 text-center text-sm font-black text-white hover:bg-emerald-700" %>
      <% else %>
        <%= link_to "Details", property_path(property), class: "flex-1 rounded-2xl bg-emerald-600 px-4 py-3 text-center text-sm font-black text-white hover:bg-emerald-700" %>
      <% end %>
    </div>
  </div>
</article>
