    <p class="text-xs font-black uppercase text-emerald-700">Owner listing</p>
    <h1 class="text-3xl font-black tracking-tight">Post a rental property</h1>
    <p class="mt-2 text-sm font-semibold text-slate-500">Add clear details so tenants can contact you with confidence.</p>
  </div>
  <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
    <%= render "form", property: @property %>
  </div>
</section>
