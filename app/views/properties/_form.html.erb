<%= form_with model: property, class: "space-y-6" do |form| %>
  <% if property.errors.any? %>
    <div class="rounded-3xl border border-rose-200 bg-rose-50 p-5 text-sm font-semibold text-rose-700">
      <p class="font-black"><%= pluralize(property.errors.count, "issue") %> need attention:</p>
      <ul class="mt-2 list-disc pl-5">
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="md:col-span-2">
      <%= form.label :title, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.text_field :title, placeholder: "Sunny 2BHK near Chanmari", class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :description, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.text_area :description, rows: 5, placeholder: "Describe rooms, parking, water, nearby shops and transport.", class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :property_type, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.select :property_type, Property.property_type_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :area, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.select :area, Property.area_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :rent, "Monthly rent", class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.number_field :rent, min: 0, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :deposit, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.number_field :deposit, min: 0, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :bedrooms, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.number_field :bedrooms, min: 0, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :bathrooms, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.number_field :bathrooms, min: 0, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :floor, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.text_field :floor, placeholder: "Ground, 1st, 2nd", class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :available_from, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.date_field :available_from, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :address, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.text_field :address, placeholder: "Full address or nearby landmark", class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :contact_name, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.text_field :contact_name, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :phone, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.telephone_field :phone, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :whatsapp_number, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.telephone_field :whatsapp_number, placeholder: "With country code", class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div>
      <%= form.label :status, class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.select :status, Property.status_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/20" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :photos, "Photos", class: "mb-1 block text-xs font-black uppercase text-slate-500" %>
      <%= form.file_field :photos, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "w-full rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm font-bold text-slate-600 file:mr-4 file:rounded-full file:border-0 file:bg-emerald-600 file:px-4 file:py-2 file:text-sm file:font-black file:text-white" %>
    </div>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row">
    <%= form.submit property.persisted? ? "Update listing" : "Publish listing", class: "rounded-2xl bg-emerald-600 px-6 py-3 text-sm font-black text-white shadow-lg shadow-emerald-600/20 hover:bg-emerald-700" %>
    <%= link_to "Cancel", property.persisted? ? property_path(property) : properties_path, class: "rounded-2xl border border-slate-200 bg-white px-6 py-3 text-center text-sm font-black text-slate-700 hover:border-emerald-300" %>
  </div>
<% end %>
