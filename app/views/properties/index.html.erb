<% content_for :title, "Search rentals - Inluah" %>

<section class="mx-auto grid max-w-7xl gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[340px_1fr] lg:px-8">
  <aside class="lg:sticky lg:top-24 lg:self-start">
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-5">
        <p class="text-xs font-black uppercase text-emerald-700">Filters</p>
        <h1 class="text-2xl font-black tracking-tight">Search rentals</h1>
      </div>
      <%= render "shared/search_form" %>
    </div>
  </aside>

  <div>
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold text-slate-500"><%= pluralize(@properties.size, "listing") %> found</p>
        <h2 class="text-3xl font-black tracking-tight">Available in Aizawl</h2>
      </div>
      <%= link_to "Post your property", new_property_path, class: "rounded-2xl bg-slate-950 px-5 py-3 text-center text-sm font-black text-white hover:bg-emerald-700" %>
    </div>

    <% if @properties.any? %>
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        <%= render partial: "properties/card", collection: @properties, as: :property %>
      </div>
    <% else %>
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <h3 class="text-2xl font-black">No listings matched</h3>
        <p class="mt-2 text-sm font-semibold text-slate-500">Try a wider rent range or another area.</p>
        <%= link_to "Clear filters", properties_path, class: "mt-5 inline-flex rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-black text-white" %>
      </div>
    <% end %>
  </div>
</section>
