<% content_for :title, "Admin - Inluah" %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-black uppercase text-emerald-700">Admin</p>
      <h1 class="text-3xl font-black tracking-tight">Inluah control room</h1>
    </div>
    <%= link_to "Manage properties", admin_properties_path, class: "rounded-2xl bg-slate-950 px-5 py-3 text-center text-sm font-black text-white hover:bg-emerald-700" %>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-black uppercase text-slate-500">Properties</p><p class="mt-3 text-4xl font-black"><%= @properties_count %></p></div>
    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-black uppercase text-slate-500">Users</p><p class="mt-3 text-4xl font-black"><%= @users_count %></p></div>
    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-black uppercase text-slate-500">Hidden</p><p class="mt-3 text-4xl font-black"><%= @hidden_count %></p></div>
    <div class="rounded-3xl bg-slate-950 p-6 text-white shadow-xl shadow-slate-950/10"><p class="text-xs font-black uppercase text-emerald-200">Inquiries</p><p class="mt-3 text-4xl font-black"><%= @inquiries_count %></p></div>
  </div>

  <div class="mt-8 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-2xl font-black tracking-tight">Recent listings</h2>
      <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-black text-emerald-700">Owner verification placeholder</span>
    </div>
    <div class="divide-y divide-slate-100">
      <% @recent_properties.each do |property| %>
        <div class="grid gap-3 py-4 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p class="font-black"><%= link_to property.title, property_path(property), class: "hover:text-emerald-700" %></p>
            <p class="text-sm font-semibold text-slate-500"><%= property.user.email %> · <%= property_area_label(property) %> · <%= property.status.humanize %></p>
          </div>
          <%= link_to "Review", admin_properties_path, class: "rounded-2xl bg-slate-100 px-4 py-2 text-center text-sm font-black text-slate-700 hover:text-emerald-700" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
