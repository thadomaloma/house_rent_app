<% content_for :title, "Manage properties - Inluah" %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <p class="text-xs font-black uppercase text-emerald-700">Admin</p>
    <h1 class="text-3xl font-black tracking-tight">Manage properties</h1>
  </div>

  <div class="space-y-4">
    <% @properties.each do |property| %>
      <article class="grid gap-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm lg:grid-cols-[140px_1fr_300px]">
        <%= link_to property_path(property), class: "aspect-[4/3] overflow-hidden rounded-2xl bg-emerald-50" do %>
          <% if property.photos.attached? %>
            <%= image_tag property.photos.first, class: "h-full w-full object-cover", alt: property.title %>
          <% else %>
            <%= image_tag "/fallback-property.svg", class: "h-full w-full object-cover", alt: "Inluah property placeholder" %>
          <% end %>
        <% end %>
        <div>
          <div class="mb-2 flex flex-wrap gap-2">
            <span class="rounded-full px-3 py-1 text-xs font-black ring-1 <%= status_badge_classes(property) %>"><%= property.status.humanize %></span>
            <% if property.featured? %><span class="rounded-full bg-emerald-600 px-3 py-1 text-xs font-black text-white">Featured</span><% end %>
          </div>
          <h2 class="text-lg font-black"><%= link_to property.title, property_path(property), class: "hover:text-emerald-700" %></h2>
          <p class="mt-1 text-sm font-semibold text-slate-500"><%= property.user.email %> · <%= property_area_label(property) %> · <%= rupees(property.rent) %>/mo</p>
          <p class="mt-3 text-sm text-slate-500">Verify property owner later placeholder</p>
        </div>
        <div class="space-y-3">
          <%= form_with model: [:admin, property], method: :patch, class: "grid grid-cols-2 gap-2" do |form| %>
            <%= form.select :status, Property.status_options, {}, class: "rounded-2xl border border-slate-200 px-3 py-2 text-sm font-bold" %>
            <label class="flex items-center justify-center gap-2 rounded-2xl bg-emerald-50 px-3 py-2 text-sm font-black text-emerald-700">
              <%= form.check_box :featured, class: "rounded border-emerald-300 text-emerald-600" %>
              Featured
            </label>
            <%= form.submit "Update", class: "col-span-2 rounded-2xl bg-slate-950 px-4 py-2 text-sm font-black text-white hover:bg-emerald-700" %>
          <% end %>
          <%= button_to "Delete", admin_property_path(property), method: :delete, data: { turbo_confirm: "Delete this property?" }, class: "w-full rounded-2xl bg-rose-50 px-4 py-2 text-sm font-black text-rose-700 hover:bg-rose-100" %>
        </div>
      </article>
    <% end %>
  </div>
</section>
